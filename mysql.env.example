# Modelo de variaveis de ambiente do MySQL (sem segredos reais).
#
# Como usar: copie este arquivo para "mysql.env" (o .gitignore ignora *.env)
# e troque os valores por senhas reais, longas e diferentes entre si.
#
#   cp mysql.env.example mysql.env        (Linux/macOS/Git Bash)
#   copy mysql.env.example mysql.env      (Prompt de Comando do Windows)
#
# Evite os caracteres  $  "  '  e espacos nas senhas: o Docker Compose
# pode interpreta-los de forma diferente do esperado.
#
# ATENCAO: o MySQL le estas senhas apenas na PRIMEIRA inicializacao, quando a
# pasta DB/ esta vazia. Mudar o valor aqui depois NAO muda a senha de um banco
# que ja foi criado.

# Senha do usuario "root" (administrador do servidor; use so para manutencao).
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-longa-1

# Senha do usuario "nexusConnection", o que a API vai usar para acessar o BancoNexus.
MYSQL_PASSWORD=troque-por-uma-senha-longa-2
