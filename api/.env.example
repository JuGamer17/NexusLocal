# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Chave usada para assinar/validar os tokens JWT.
# Gere uma nova com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=coloque_aqui_uma_chave_aleatoria_e_secreta

# Usuário administrador temporário (enquanto a tabela Usuario do MySQL
# ainda não está integrada à API).
ADMIN_USERNAME=seu_usuario

# Hash bcrypt da senha (NUNCA a senha em texto puro).
# Gere com:
#   from passlib.context import CryptContext
#   CryptContext(schemes=["bcrypt"]).hash("sua_senha")
ADMIN_PASSWORD_HASH=cole_aqui_o_hash_bcrypt_gerado
